/* custom-tab-bar sits outside page, so these colors are literals. */
.tn-tabbar {
  display: flex;
  height: calc(100rpx + env(safe-area-inset-bottom));
  padding-bottom: env(safe-area-inset-bottom);
  box-sizing: border-box;
  background: #f4efe4;
  border-top: 1px solid #14110f;
}

.tn-tabbar--page {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 50;
}

.tn-tabbar__item {
  flex: 1;
  min-height: 88rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  padding-bottom: 6px;
  box-sizing: border-box;
  font-family: "SF Mono", Menlo, Consolas, monospace;
  font-size: 24rpx;
  letter-spacing: 0.06em;
  color: #5b544b;
  position: relative;
}

.tn-tabbar__ico {
  font-size: 32rpx;
  line-height: 1;
  font-weight: 700;
}

.tn-tabbar__item--on {
  color: #14110f;
  font-weight: 700;
}

.tn-tabbar__item--on::after {
  content: "";
  position: absolute;
  left: 28%;
  right: 28%;
  bottom: 2px;
  height: 3px;
  background: #ff4f12;
}
