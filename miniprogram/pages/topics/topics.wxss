.tn-route {
  display: flex;
  align-items: center;
  gap: var(--tn-space-3);
  min-height: var(--tn-tap);
  margin-bottom: var(--tn-space-3);
  padding: var(--tn-space-3);
  background: var(--tn-accent-weak);
  border: var(--tn-border);
  box-shadow: var(--tn-shadow);
  box-sizing: border-box;
}

.tn-route__main {
  flex: 1;
  min-width: 0;
}

.tn-route__k {
  display: block;
  font-family: var(--tn-mono);
  font-size: var(--tn-fs-xs);
  font-weight: 700;
  color: var(--tn-accent);
  letter-spacing: 0.06em;
}

.tn-route__t {
  display: block;
  margin-top: 4rpx;
  font-size: var(--tn-fs-lg);
  font-weight: 800;
  line-height: 1.3;
}

.tn-route__en {
  display: block;
  font-family: var(--tn-mono);
  font-size: var(--tn-fs-xs);
  color: var(--tn-muted);
  letter-spacing: 0.04em;
}

.tn-route__go {
  font-family: var(--tn-mono);
  font-size: var(--tn-fs-xl);
  font-weight: 700;
}

.tn-xp {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--tn-space-2);
  min-height: var(--tn-tap);
  margin-bottom: var(--tn-space-3);
  padding: var(--tn-space-2) var(--tn-space-3);
  background: var(--tn-bg);
  border: var(--tn-border);
  box-sizing: border-box;
}

.tn-xp__n {
  font-family: var(--tn-mono);
  font-size: var(--tn-fs-md);
  font-weight: 800;
  color: var(--tn-accent);
  letter-spacing: 0.04em;
}

.tn-xp__b {
  flex: 1;
  font-family: var(--tn-mono);
  font-size: var(--tn-fs-xs);
  line-height: 1.4;
  color: var(--tn-ink);
  text-align: right;
}
